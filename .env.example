# Postgres connection string
DATABASE_URL="postgresql://lrd:lrd@localhost:5432/lrd_calculator"
# Secret used to sign session tokens (generate with: openssl rand -hex 32)
AUTH_SECRET="change-me"
# Anthropic API key — required for the LOI / lease deed OCR extraction pipeline
# Get yours at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-..."
# Optional: override the model used for LOI extraction if your account
# does not have access to the default (claude-sonnet-4-6)
# LOI_EXTRACTION_MODEL="claude-sonnet-4-5"
